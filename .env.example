# Copy to .env and fill in real values. Never commit .env.
# Every variable here must also be listed in docs/CONTRACT.md.

# Stoa dataset roots (outside git)
STOA_DATA=
STOA_PREVIEW=
# Overnight shared panel, Python env, model weights, agent id
JUNCTION_SHARED=
JUNCTION_VENV=
MODEL_DIR=
AGENT_ID=
# Shared local OpenAI-compatible model server (vLLM)
LLM_BASE_URL=http://127.0.0.1:8001/v1
# Hosted NVIDIA API (Nemotron 3.5 Super VL, Gemma 3); base URL https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
